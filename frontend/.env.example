# Starknet RPC URL
VITE_RPC_URL=http://localhost:5050

# Torii Indexer URL
VITE_TORII_URL=http://localhost:8080

# Dojo World Contract Address (get this after deployment)
VITE_WORLD_ADDRESS=0x

# Telegram Bot Token (get from @BotFather)
VITE_TELEGRAM_BOT_TOKEN=

# Environment (development, staging, production)
VITE_ENV=development

# Network (katana, sepolia, mainnet)
VITE_NETWORK=katana

# ── Neon Database (server-side only — set in Vercel env vars, NOT here) ───────
# DATABASE_URL=postgresql://neondb_owner:...@...neon.tech/neondb?sslmode=require
# TELEGRAM_BOT_TOKEN=   (same token, for server-side auth verification)

# API base URL (leave empty for same-domain Vercel deployment)
VITE_API_URL=

