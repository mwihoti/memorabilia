# Starknet Sepolia RPC URL (Cartridge)
VITE_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# Torii Indexer URL (Cartridge)
VITE_TORII_URL=https://api.cartridge.gg/x/torii/sepolia

# Dojo World Contract Address (update after deployment to Sepolia)
VITE_WORLD_ADDRESS=0x

# NFT Contract Address (update after deployment to Sepolia)
VITE_NFT_CONTRACT_ADDRESS=0x

# Bot username used in invite links (without @). Never put the bot token in a
# VITE_ variable: those are bundled into the public JavaScript.
VITE_BOT_USERNAME=enter_memorabilia_musem_bot

# Environment
VITE_ENV=production

# Network
VITE_NETWORK=sepolia

